#MicroXplorer Configuration settings - do not modify
Mcu.Family=STM32F1
Mcu.Name=STM32F103C(8-B)Tx
Mcu.Package=LQFP48
Mcu.UserName=STM32F103C8Tx
MxCube.Version=6.10.0
MxDb.Version=DB.6.0.100
ProjectManager.ProjectName=Smart_Greenhouse_and_Water_Tank_Manager
ProjectManager.ToolChain=MDK-ARM V5
ProjectManager.UnderRoot=true
ProjectManager.BackupPrevious=false
ProjectManager.DeletePrevious=true
ProjectManager.NoMain=false
ProjectManager.TargetToolchain=MDK-ARM
ProjectManager.CompilerOptimize=2
ProjectManager.StackSize=0x400
ProjectManager.HeapSize=0x400
ProjectManager.AskForClockConfig=false

# Enabled IPs
Mcu.IP=ADC1,I2C1,TIM1,RCC,SYS,GPIO

# RCC (Clock) - 72MHz from 8MHz HSE
RCC.HSE_VALUE=8000000
RCC.LSE_VALUE=32768
RCC.MCOFreq_Value=72000000
RCC.AHBFreq_Value=72000000
RCC.APB1Freq_Value=36000000
RCC.APB2Freq_Value=72000000
RCC.APB2TimFreq_Value=72000000
RCC.APB1TimFreq_Value=72000000
RCC.SYSCLKSource=RCC_SYSCLKSOURCE_PLLCLK
RCC.PLL.PLLSource=RCC_PLLSOURCE_HSE
RCC.PLL.PLLMul=RCC_PLL_MUL9
RCC.IPParameters=HSE_VALUE,LSE_VALUE,SYSCLKSource,AHBFreq_Value,APB1Freq_Value,APB2Freq_Value,APB2TimFreq_Value,APB1TimFreq_Value,PLL.PLLSource,PLL.PLLMul,MCOFreq_Value

# SYS/Debug
SYS.IPParameters=Debug
SYS.Debug=SYS_JTAG_SWD  # Keep SWD; JTAG can be disabled in user code

# I2C1 - LCD (PB6/PB7) 100kHz
I2C1.IPParameters=ClockSpeed,DutyCycle
I2C1.ClockSpeed=100000
I2C1.DutyCycle=I2C_DUTYCYCLE_2
I2C1.Instance=I2C1

# ADC1 - Soil on PA0 (IN0), sample 71.5 cycles
ADC1.IPParameters=Rank-0\#Channel,Rank-0\#SamplingTime,ContinuousConvMode,DiscontinuousConvMode,NbrOfConversion,ExternalTrigConv
ADC1.ContinuousConvMode=DISABLE
ADC1.DiscontinuousConvMode=DISABLE
ADC1.NbrOfConversion=1
ADC1.ExternalTrigConv=ADC_SOFTWARE_START
ADC1.Rank-0\#Channel=ADC_CHANNEL_0
ADC1.Rank-0\#SamplingTime=ADC_SAMPLETIME_71CYCLES_5

# TIM1 - Servo PWM on PA8 (CH1), 50Hz
TIM1.IPParameters=Prescaler,Period,CounterMode,Channel-Pulse
TIM1.Prescaler=71
TIM1.Period=19999
TIM1.CounterMode=TIM_COUNTERMODE_UP
TIM1.Channel-Pulse=1000

# GPIO pins
# Ultrasonic
PB0.GPIOParameters=GPIO_Label,GPIO_ModeDefaultPP,GPIO_PuPd
PB0.GPIO_Label=TRIG
PB0.GPIO_ModeDefaultPP=GPIO_MODE_OUTPUT_PP
PB0.GPIO_PuPd=GPIO_NOPULL
PB0.Locked=true
PB0.Signal=GPIO_Output

PB1.GPIOParameters=GPIO_Label,GPIO_Mode,GPIO_PuPd
PB1.GPIO_Label=ECHO
PB1.GPIO_Mode=GPIO_MODE_INPUT
PB1.GPIO_PuPd=GPIO_NOPULL
PB1.Locked=true
PB1.Signal=GPIO_Input

# I2C LCD
PB6.GPIOParameters=GPIO_Label
PB6.GPIO_Label=I2C1_SCL
PB6.Locked=true
PB6.Signal=I2C1_SCL

PB7.GPIOParameters=GPIO_Label
PB7.GPIO_Label=I2C1_SDA
PB7.Locked=true
PB7.Signal=I2C1_SDA

# DHT11
PB10.GPIOParameters=GPIO_Label,GPIO_Mode,GPIO_PuPd
PB10.GPIO_Label=DHT11
PB10.GPIO_Mode=GPIO_MODE_INPUT
PB10.GPIO_PuPd=GPIO_NOPULL
PB10.Locked=true
PB10.Signal=GPIO_Input

# Soil probe power (optional)
PB12.GPIOParameters=GPIO_Label,GPIO_ModeDefaultPP,GPIO_PuPd
PB12.GPIO_Label=SOIL_PWR
PB12.GPIO_ModeDefaultPP=GPIO_MODE_OUTPUT_PP
PB12.GPIO_PuPd=GPIO_NOPULL
PB12.Locked=true
PB12.Signal=GPIO_Output

# ADC pin PA0
PA0.GPIOParameters=GPIO_Label
PA0.GPIO_Label=SOIL_AO
PA0.Locked=true
PA0.Signal=ADCx_IN0

# Servo PWM
PA8.GPIOParameters=GPIO_Label
PA8.GPIO_Label=SERVO_PWM
PA8.Locked=true
PA8.Signal=TIM1_CH1

# LEDs
PA10.GPIOParameters=GPIO_Label,GPIO_ModeDefaultPP,GPIO_PuPd
PA10.GPIO_Label=LED_G
PA10.GPIO_ModeDefaultPP=GPIO_MODE_OUTPUT_PP
PA10.GPIO_PuPd=GPIO_NOPULL
PA10.Locked=true
PA10.Signal=GPIO_Output

PA11.GPIOParameters=GPIO_Label,GPIO_ModeDefaultPP,GPIO_PuPd
PA11.GPIO_Label=LED_Y
PA11.GPIO_ModeDefaultPP=GPIO_MODE_OUTPUT_PP
PA11.GPIO_PuPd=GPIO_NOPULL
PA11.Locked=true
PA11.Signal=GPIO_Output

PA12.GPIOParameters=GPIO_Label,GPIO_ModeDefaultPP,GPIO_PuPd
PA12.GPIO_Label=LED_R
PA12.GPIO_ModeDefaultPP=GPIO_MODE_OUTPUT_PP
PA12.GPIO_PuPd=GPIO_NOPULL
PA12.Locked=true
PA12.Signal=GPIO_Output
